# Copier ce fichier en `.env` (jamais commité) et renseigner les valeurs.
# Les variables seront complétées au fil des lots (BF-002 : PostgreSQL, Mailpit, etc.).

# PostgreSQL (BF-002)
POSTGRES_USER=bankflow_admin
POSTGRES_PASSWORD=change-me

# Ports publiés sur 127.0.0.1 (à changer si le port est déjà pris sur ton poste)
POSTGRES_HOST_PORT=5432
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8090
GATEWAY_HOST_PORT=8080

# Mots de passe des utilisateurs par service (BF-002)
AUTH_DB_PASSWORD=change-me
CUSTOMER_DB_PASSWORD=change-me
BANKING_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
ANALYTICS_DB_PASSWORD=change-me

# Compte administrateur initial (BF-005)
ADMIN_EMAIL=admin@bankflow.local
ADMIN_PASSWORD=change-me

# Origines autorisées à appeler la Gateway depuis un navigateur (BF-004)
CORS_ALLOWED_ORIGINS=http://localhost:4200
