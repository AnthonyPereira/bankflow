{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bankflow.local/contracts/events/envelope.v1.schema.json",
  "title": "Enveloppe d'événement BankFlow",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "producer", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "eventVersion": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "payload": { "type": "object" }
  }
}
